---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import ServiceTimesCard from "../components/ServiceTimesCard.astro";
import TextWithSideImages from "../components/TextWithSideImages.astro";
import ImageWithText from "../components/ImageWithText.astro";
import QuickLinks from "../components/QuickLinks.astro";
import IconGrid from "../components/IconGrid.astro";
import BannerImage from "../components/BannerImage.astro";
import OrnateSteps from "../components/OrnateSteps.astro";

let entry, cacheHint;
try {
	const result = await getEmDashEntry("pages", "home");
	entry = result?.entry;
	cacheHint = result?.cacheHint;
	if (cacheHint) Astro.response.headers.set("Cache-Control", cacheHint);
} catch (e) {
	console.error("Failed to load home page:", e);
}
---

<Base isHome={true}>
	{/* ===== HERO — photo strip + oval overlay + dome ===== */}
	<div class="hero-photos">
		<img src="/images/home/homepage-hero-arched-panel-02.webp" alt="Church Life" />
		<img src="/images/home/homepage-hero-arched-panel-05.webp" alt="Church Life" />
		<img src="/images/home/homepage-hero-arched-panel-06.webp" alt="Church Life" />
		<img src="/images/home/homepage-hero-arched-panel-03.webp" alt="Church Life" />
	</div>

	<section class="hero-tagline">
		<div class="hero-tagline-oval">
			{/* SVG lens shape background */}
			<svg class="hero-tagline-bg" viewBox="0 0 1600 500" preserveAspectRatio="none" aria-hidden="true">
				<path d="M-500,250 Q800,-80 2100,250 Q800,580 -500,250 Z" fill="var(--brand-cream, #f5f0e8)" />
			</svg>
			<div class="hero-tagline-content">
				<div class="hero-seal">
					<img src="/logo.webp" alt="Holy Resurrection Antiochian Orthodox Church" class="hero-seal-img" />
				</div>
				<p class="hero-quote">Rooted in Tradition, Alive in Christ</p>
				<p class="hero-welcome">Welcoming all who seek the ancient Christian faith</p>
			</div>
		</div>
	</section>

	<div class="dome-banner">
		<div class="dome-banner-border"></div>
	</div>

	{/* ===== Services & Events Card ===== */}
	<ServiceTimesCard />

	{/* ===== "Visiting a church can be intimidating" Banner ===== */}
	<div class="intimidating-border-top"></div>
	<section class="intimidating-banner">
		<div class="intimidating-bg"></div>
		<div class="intimidating-overlay">
			<p class="intimidating-text">Visiting a church can be intimidating...<br />especially an Orthodox one.</p>
		</div>
	</section>
	<div class="intimidating-border-bottom"></div>

	{/* ===== "We are a church that walks with you" ===== */}
	<ImageWithText
		title="We are a church that walks with you."
		titleStyle="script"
		content="Being part of Ancient Orthodox Christianity is to be welcomed onto a more profound journey of deep, quiet, spiritual growth, by faithfully immersing oneself in all the mysteries of the Apostolic traditions; the Holy Trinity, Sacraments, studying the Scriptures and lives of the Saints, attending services, daily prayer and fasting brings your entire being into direct experiential encounter with the Triune God, transforming one's whole heart and becoming one with the loving body of Christ and hearing the voice of the Lord."
		quote={`"Leave everything to God, my child, and you will immediately see how peaceful you will be, how much joy you will feel immediately and how much comfort and peace you will find."`}
		quoteAttribution="— St. Ephraim of Katounakia"
		secondaryHeading="The Apostolic Faith"
		secondaryContent="Following the true Faith of the Apostles, who directly received and spread the word of Christ, is a commitment to strive to be more Christ-like, to know a profoundly deep peace, expressing faith through acts of love, and service to mankind, allowing God's grace to manifest, bringing Heaven to Earth."
		image={{ src: "/images/home/homepage-getting-to-know-us-candles-feature-panel.webp", alt: "Parish Life" }}
		buttonText="Learn More About Who We Are"
		buttonHref="/about"
	/>

	{/* ===== Quick Links ===== */}
	<QuickLinks
		title="Quick Links"
		links={[
			{
				image: "/images/home/homepage-quick-links-image-01.webp",
				alt: "Contact Us",
				text: "Contact Us",
				href: "/contact",
			},
			{
				image: "/images/home/homepage-quick-links-image-02.webp",
				alt: "Donate",
				text: "Donate",
				href: "/donate",
			},
			{
				image: "/images/home/homepage-quick-links-image-03.webp",
				alt: "Join Us Online",
				text: "Join Us Online",
				href: "/visitors",
			},
		]}
	/>

	{/* ===== What You'll Find Here ===== */}
	<IconGrid
		title="What You'll Find Here"
		items={[
			{
				icon: "/images/home/homepage-what-youll-find-here-arched-panel-01.webp",
				alt: "Ancient Worship",
				title: "Ancient Worship",
				description: "Rooted in scripture, tradition, and the life of the early church",
			},
			{
				icon: "/images/home/homepage-what-youll-find-here-arched-panel-02.webp",
				alt: "Christ at the Center",
				title: "Christ at the Center",
				description: "Everything we do is oriented toward our Savior, the God-Man, Jesus Christ",
			},
			{
				icon: "/images/home/homepage-what-youll-find-here-arched-panel-03.webp",
				alt: "Living Community",
				title: "Living Community",
				description: "Shared meals, feasts, prayer, and spiritual formation",
			},
		]}
	/>

	{/* ===== Your First Visit ===== */}
	<OrnateSteps
		title="Your First Visit"
		steps={[
			{ title: "Come as you are", description: "Attend a Sunday Divine Liturgy or Vespers" },
			{ title: "Observe and receive", description: "No pressure to participate—simply be present" },
			{ title: "Stay and connect", description: "Join us for fellowship and conversation" },
		]}
		image={{ src: "/images/home/homepage-plan-your-visit-image.webp", alt: "First Visit" }}
		buttonText="Plan Your Visit"
		buttonHref="/visitors"
	/>
</Base>

<style>
	/* ===== Hero photo strip — full bleed, no gaps ===== */
	.hero-photos {
		display: flex;
		width: 100%;
		height: 22rem;
		overflow: hidden;
		margin-bottom: 0;
		line-height: 0;
		background: var(--brand-primary);
		gap: 3px;
	}

	.hero-photos img {
		flex: 1;
		min-width: 0;
		height: 100%;
		object-fit: cover;
		display: block;
		clip-path: inset(8% 7% 0% 7%);
		margin: 0 -7.5%;
	}

	@media (min-width: 768px) {
		.hero-photos { height: 28rem; }
	}

	@media (min-width: 1200px) {
		.hero-photos { height: 32rem; }
	}

	@media (max-width: 480px) {
		.hero-photos { height: 16rem; }
	}

	/* ===== Tagline — SVG lens shape overlapping photos & dome ===== */
	.hero-tagline {
		position: relative;
		z-index: 5;
		margin-top: -14rem;
		margin-bottom: -1rem;
		pointer-events: none;
	}

	.hero-tagline-oval {
		position: relative;
		pointer-events: auto;
		width: 100%;
	}

	.hero-tagline-bg {
		display: block;
		width: 100%;
		height: auto;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-tagline-content {
		position: relative;
		z-index: 2;
		text-align: center;
		padding: 4.5rem 4rem 4.5rem;
	}

	@media (max-width: 600px) {
		.hero-tagline {
			margin-top: -8rem;
			margin-bottom: -6rem;
		}
		.hero-tagline-content {
			padding: 2.5rem 1.5rem 2.5rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-tagline {
			margin-top: -16rem;
			margin-bottom: -2rem;
		}
		.hero-tagline-content {
			padding: 5.5rem 5rem 5.5rem;
		}
	}

	.hero-seal {
		display: flex;
		justify-content: center;
		margin-bottom: 0.75rem;
	}

	.hero-seal-img {
		width: 8rem;
		height: 8rem;
		object-fit: contain;
		filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.15));
	}

	@media (min-width: 768px) {
		.hero-seal-img {
			width: 10rem;
			height: 10rem;
		}
	}

	.hero-quote {
		font-family: var(--font-quote-stack);
		font-size: clamp(1.8rem, 4.5vw, 3.5rem);
		color: var(--brand-primary);
		font-style: italic;
		letter-spacing: 0.02em;
		line-height: 1.2;
		margin-bottom: 0.75rem;
	}

	.hero-welcome {
		font-family: var(--font-heading);
		font-size: clamp(0.65rem, 1.5vw, 1rem);
		color: var(--brand-primary);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-weight: 600;
	}

	/* ===== Dome Banner ===== */
	.dome-banner {
		width: 100%;
		height: 75vh;
		min-height: 500px;
		background: url('/landing-dome-banner.webp') center 40% / cover no-repeat;
		position: relative;
	}

	@media (min-width: 1024px) {
		.dome-banner {
			background-attachment: fixed;
		}
	}

	.dome-banner-border {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 40px;
		background: url('/border-section-divider.webp') repeat-x center / auto 100%;
	}

	/* Intimidating banner */
	.intimidating-banner {
		background: url('/images/home/homepage-getting-to-know-us-candles-feature-panel.webp') center / cover no-repeat;
		position: relative;
		min-height: 350px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.intimidating-bg {
		display: none;
	}

	.intimidating-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.65);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem;
	}

	@media (max-width: 768px) {
		.intimidating-banner {
		}
	}

	.intimidating-border-top,
	.intimidating-border-bottom {
		height: 40px;
		background: url('/border-section-divider.webp') repeat-x center / auto 100%;
	}

	.intimidating-text {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		color: var(--brand-cream);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		text-align: center;
		line-height: 1.5;
	}

</style>

