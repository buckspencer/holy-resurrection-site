---
/**
 * Services & Upcoming Events card matching mockup spec.
 * Two-column layout: Services (left) with icon/address, Events (right) with time pills.
 */
const apiKey = import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY;
let gcalEvents: any[] = [];

if (apiKey) {
	try {
		const now = new Date().toISOString();
		const calIds = [
			"fphroc@gmail.com",
			"ngc5qpqbmjcfcgnu69ign2vt58@group.calendar.google.com",
			"kac7561aviq3totv40g23pr234@group.calendar.google.com",
			"pvj2v0pn4f95pc7skfjp4v51uo@group.calendar.google.com",
			"emu7o5mqkat1oko8j56margj0g@group.calendar.google.com",
		];
		const allEvents: any[] = [];
		await Promise.all(calIds.map(async (id) => {
			try {
				const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(id)}/events?key=${apiKey}&timeMin=${now}&maxResults=4&singleEvents=true&orderBy=startTime`;
				const res = await fetch(url);
				if (!res.ok) return;
				const data = await res.json();
				for (const item of data.items || []) {
					const start = item.start?.dateTime || item.start?.date || "";
					const d = new Date(start);
					const dateStr = d.toLocaleDateString("en-US", { weekday: "long", month: "short", day: "numeric" });
					const timeStr = item.start?.dateTime
						? d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
						: "All Day";
					allEvents.push({ title: item.summary || "", date: dateStr, time: timeStr, start, link: item.htmlLink || "" });
				}
			} catch {}
		}));
		allEvents.sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime());
		gcalEvents = allEvents.slice(0, 4);
	} catch {}
}
---

<section class="services-card">
	<div class="services-grid">
		<!-- Services column -->
		<div class="services-col">
			<h3 class="col-heading">Services</h3>

			<div class="service-block">
				<span class="service-day">Saturday</span>
				<span class="service-time">Vespers | 5:00 pm</span>
			</div>

			<div class="service-block">
				<span class="service-day">Sunday</span>
				<span class="service-time">Orthros | 9:00 am</span>
				<span class="service-time">Divine Liturgy | 10:00 am</span>
			</div>

			<a href="/events" class="calendar-btn">View Full Calendar</a>

			<div class="services-location">
				<div class="services-icon">
					<img src="/images/home/hroc-church-illustration.webp" alt="Holy Resurrection Antiochian Orthodox Church" />
				</div>
				<p>We are located at</p>
				<p class="address-line">5901 E. 5th Street, Tucson, AZ 85711</p>
			</div>
		</div>

		<!-- Events column -->
		<div class="events-col">
			<h3 class="col-heading">Upcoming Events</h3>

			{gcalEvents.length > 0 ? (
				gcalEvents.map((event) => (
					<a href={event.link} target="_blank" rel="noreferrer" class="event-item event-link">
						<span class="event-title">{event.title}</span>
						<span class="event-date">{event.date}</span>
						<div class="event-pill">{event.time}</div>
					</a>
				))
			) : (
				<>
					<div class="event-item">
						<span class="event-title">Sunday Divine Liturgy</span>
						<span class="event-date">Every Sunday</span>
						<div class="event-pill">9:00 AM - Orthros & 10:00 AM - Divine Liturgy</div>
					</div>
					<div class="event-item">
						<span class="event-title">Saturday Vespers</span>
						<span class="event-date">Every Saturday</span>
						<div class="event-pill">5:00 PM - Vespers</div>
					</div>
				</>
			)}
		</div>
	</div>
</section>

<style>
	.services-card {
		max-width: 100%;
		margin: 0;
		padding: 0;
		background: #c5c9ca;
		overflow: hidden;
	}

	.services-grid {
		padding: 3rem 3rem 2rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}


	@media (max-width: 600px) {
		.services-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	.col-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2rem);
		color: var(--brand-primary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 1.5rem;
	}

	/* Services column */
	.services-col {
		text-align: center;
	}

	.service-block {
		margin-bottom: 1.25rem;
	}

	.service-day {
		display: block;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		color: var(--brand-primary);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}

	.service-time {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 1.1rem;
		color: var(--brand-primary);
	}

	.calendar-btn {
		display: inline-block;
		margin-top: 0.75rem;
		margin-bottom: 1.5rem;
		padding: 0.5rem 1.25rem;
		border: 2px solid var(--brand-primary);
		color: var(--brand-primary);
		font-family: var(--font-body-stack);
		font-size: 0.85rem;
		text-decoration: none;
		letter-spacing: 0.04em;
		transition: all 0.2s ease;
	}

	.calendar-btn:hover {
		background: var(--brand-primary);
		color: white;
	}

	.services-location {
		text-align: center;
		font-family: var(--font-body-stack);
		font-size: 0.85rem;
		color: rgba(0, 0, 0, 0.6);
		line-height: 1.5;
	}

	.services-icon {
		width: 8rem;
		margin: 0 auto -1.5rem;
		position: relative;
		z-index: 1;
	}

	.services-icon img {
		width: 100%;
		height: auto;
	}

	.address-line {
		font-weight: 600;
		color: var(--brand-primary);
	}

	/* Events column */
	.events-col {
		text-align: left;
	}

	.event-item {
		padding-bottom: 1.25rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
	}

	.event-link {
		text-decoration: none;
		transition: background-color 0.2s ease;
		display: block;
		border-radius: 6px;
		padding: 0.75rem;
		margin: -0.75rem;
		margin-bottom: 1.25rem;
	}

	.event-link:hover {
		background: rgba(0, 0, 0, 0.05);
	}

	.event-item:last-child {
		border-bottom: none;
		margin-bottom: 0;
	}

	.event-title {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 0.95rem;
		color: var(--brand-primary);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.event-date {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 0.8rem;
		color: rgba(0, 0, 0, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.5rem;
	}

	.event-pill {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		background: rgba(0, 0, 0, 0.08);
		font-family: var(--font-body-stack);
		font-size: 0.8rem;
		color: rgba(0, 0, 0, 0.7);
	}
</style>
