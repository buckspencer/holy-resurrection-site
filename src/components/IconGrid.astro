---
/**
 * Three-column grid with arch-framed icons and golden rays.
 * Ported from IconWithTextGrid.tsx
 */
interface Props {
	title: string;
	items: {
		icon: string;
		alt: string;
		title: string;
		description: string;
	}[];
}

const { title, items } = Astro.props;
---

<section class="icon-grid">
	<div class="container">
		<h2 class="icon-grid-title">{title}</h2>

		<div class="icon-grid-items reveal-stagger">
			{items.map((item) => (
				<div class="icon-item">
					<div class="icon-frame-wrap">
						<img src={item.icon} alt={item.alt} loading="lazy" />
					</div>
					<h3 class="icon-item-title">{item.title}</h3>
					<p class="icon-item-desc">{item.description}</p>
				</div>
			))}
		</div>
	</div>

</section>

<style>
	.icon-grid {
		padding: 4rem var(--site-gutter) 2rem;
		background: #ffffff;
	}

	.icon-grid-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--brand-rust);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		text-align: center;
		margin-bottom: 3rem;
		font-style: italic;
	}

	.icon-grid-items {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 5rem;
		text-align: center;
	}

	@media (max-width: 768px) {
		.icon-grid-items {
			grid-template-columns: 1fr;
			max-width: 20rem;
			margin: 0 auto;
		}
	}

	.icon-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.icon-frame-wrap {
		width: 100%;
		max-width: 20rem;
		transition: transform 0.5s ease;
		margin-bottom: 1.5rem;
	}

	.icon-frame-wrap:hover {
		transform: scale(1.05);
	}

	.icon-frame-wrap img {
		width: 100%;
		height: auto;
		display: block;
	}

	.icon-item-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		color: var(--brand-rust);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.75rem;
	}

	.icon-item-desc {
		font-family: var(--font-body-stack);
		font-size: var(--font-size-base);
		color: var(--brand-rust);
		line-height: 1.7;
		max-width: 18rem;
	}

</style>
